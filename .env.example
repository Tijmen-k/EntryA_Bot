# ── Trading mode ───────────────────────────────────────────
# "demo"  → connects to demo-futures.kraken.com (paper money)
# "live"  → connects to futures.kraken.com      (real money)
TRADING_MODE=demo

# ── Kraken Futures API credentials ─────────────────────────
# Get these from your Kraken Futures account:
#   demo: https://demo-futures.kraken.com → Settings → API
#   live: https://futures.kraken.com      → Settings → API
KRAKEN_API_KEY=your_demo_api_key_here
KRAKEN_API_SECRET=your_demo_api_secret_here

# ── Instrument ──────────────────────────────────────────────
# PF_ETHUSD = ETH Linear Perpetual (USD-margined, recommended)
# PI_ETHUSD = ETH Inverse Perpetual (ETH-margined)
SYMBOL=PF_ETHUSD

# ── Risk settings ───────────────────────────────────────────
RISK_PER_TRADE_PCT=0.01    # 1% of account per trade
LEVERAGE=5.0               # 5x — conservative for live; bump to 10 only after validation

# ── Safety ─────────────────────────────────────────────────
# Set to "true" to run without placing any real orders (read-only)
DRY_RUN=true

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
