# ── Trading mode ────────────────────────────────────────────
# Bitget uses the same API URL for both demo and live.
# Demo = paper trading account; live = real account.
TRADING_MODE=demo

# ── Bitget Futures API credentials ──────────────────────────
# Create API keys in your Bitget account:
#   demo: https://www.bitget.com → Demo Trading → API Management
#   live: https://www.bitget.com → Profile → API Management
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_API_PASSPHRASE=your_api_passphrase_here

# ── Instrument ──────────────────────────────────────────────
# Coin-M inverse perpetual (productType=coin-futures), margin in ETH
SYMBOL=ETHUSD

# ── Contract size ───────────────────────────────────────────
# ETH per contract for ETHUSDT on Bitget (check your contract spec)
CONTRACT_SIZE=0.01

# ── Risk settings ───────────────────────────────────────────
RISK_PER_TRADE_PCT=0.01    # 1% of account per trade
LEVERAGE=50               # 5x — set your actual leverage in Bitget account settings too

# ── Safety ─────────────────────────────────────────────────
# Set to "true" to run without placing any real orders (read-only)
DRY_RUN=true

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO

# -- Discord notifications ---------------------------------------------------
# Create a webhook in your Discord channel:
#   Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Leave blank to disable all Discord alerts.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1521167500321230909/JnhxpxVHU4tYyw-01KMHpDbcadwh7t7A_PZVoVr6MtsWo2tOocNcTfPAYG42SBdGk9q5

# Heartbeat ping interval in minutes (0 = disabled)
DISCORD_HEARTBEAT_INTERVAL_MINS=60
