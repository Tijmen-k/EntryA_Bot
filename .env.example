# ── Trading mode ────────────────────────────────────────────
# Bitget uses the same API URL for both demo and live.
# Demo = paper trading account; live = real account.
TRADING_MODE=demo

# ── Bitget Futures API credentials ──────────────────────────
# Bitget issues SEPARATE keys per environment — a demo key will not
# authenticate against the live account, and vice versa. Keep both sets
# here; TRADING_MODE above picks which one config.py actually loads.
#   demo: https://www.bitget.com → Demo Trading → API Management
#   live: https://www.bitget.com → Profile → API Management
BITGET_DEMO_API_KEY=your_demo_api_key_here
BITGET_DEMO_API_SECRET=your_demo_api_secret_here
BITGET_DEMO_API_PASSPHRASE=your_demo_api_passphrase_here

BITGET_LIVE_API_KEY=your_live_api_key_here
BITGET_LIVE_API_SECRET=your_live_api_secret_here
BITGET_LIVE_API_PASSPHRASE=your_live_api_passphrase_here

# ── Instrument ──────────────────────────────────────────────
# Coin-M inverse perpetual (productType=coin-futures), margin in ETH
SYMBOL=ETHUSD

# ── Contract size ───────────────────────────────────────────
# ETH per contract for ETHUSDT on Bitget (check your contract spec)
CONTRACT_SIZE=0.01

# ── Risk settings ───────────────────────────────────────────
RISK_PER_TRADE_PCT=0.01    # 1% of account per trade
LEVERAGE=50               # 5x — set your actual leverage in Bitget account settings too

# ── Safety ─────────────────────────────────────────────────
# Set to "true" to run without placing any real orders (read-only)
DRY_RUN=true

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Dashboard login (Streamlit) ──────────────────────────────
# Generate with: python scripts/generate_login_secret.py
DASHBOARD_PASSWORD_SALT=
DASHBOARD_PASSWORD_HASH=

# -- Discord notifications ---------------------------------------------------
# Create a webhook in your Discord channel:
#   Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Leave blank to disable all Discord alerts.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Heartbeat ping interval in minutes (0 = disabled)
DISCORD_HEARTBEAT_INTERVAL_MINS=60

# ── Discord control-center bot (discord_bot/) ────────────────────────────────
# A slash-command bot, separate from the webhook alerts above. Run with:
#   python -m discord_bot
# Create an application + bot at https://discord.com/developers/applications,
# enable it, and invite it to your server with the "applications.commands" and
# "bot" scopes (Administrator permission recommended for the admin commands).
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional: restricts slash-command registration to one guild for instant sync
# while testing (global sync can take up to an hour to propagate). Leave blank
# to sync globally.
DISCORD_GUILD_ID=

# Optional: if set, commands only respond when invoked in this channel.
DISCORD_COMMAND_CHANNEL_ID=

# Path to the bot's own SQLite database (alert subscriptions, audit log).
DISCORD_BOT_DB_PATH=discord_bot/data/bot.db

# Cache TTLs (seconds) for read-only account queries — protects the single
# Bitget account from being hammered if multiple users run commands at once.
DISCORD_ACCOUNT_CACHE_TTL_S=20
DISCORD_MARKET_CACHE_TTL_S=30
