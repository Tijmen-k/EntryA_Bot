# Normalize line endings: LF in repo, checkout as native
* text=auto eol=lf

# Force LF for shell/Docker/Python files on all platforms
*.py      text eol=lf
*.sh      text eol=lf
Dockerfile text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
.env*     text eol=lf
